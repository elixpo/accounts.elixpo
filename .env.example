# Elixpo Accounts - example environment for local development
#
# The committed `.env` is SOPS-encrypted and only maintainers can decrypt it.
# Newcomers: copy this file and fill in only what you need.
#
#   cp .env.example .env.local
#
# Keep every key below in .env.local, even when empty: Next.js also loads the
# encrypted `.env`, and a key you omit here would pick up its `ENC[...]` value
# (e.g. JWT_EXPIRATION_MINUTES would parse as NaN).
#
# D1 (DB) and KV are Cloudflare bindings declared in wrangler.toml and
# emulated locally by `next dev` (setupDevPlatform); they are not env vars.
# Apply the schema once with `npm run db:migrate:local`.

# ---------------------------------------------------------------------------
# Required to run locally
# ---------------------------------------------------------------------------
# Public origin of this app; used as the JWT issuer and in redirects/links.
# Several code paths fall back to https://accounts.elixpo.com when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ed25519 (EdDSA) keypair used to sign and verify access tokens. Sign-in,
# token and session routes throw without them. Generate a THROWAWAY local
# pair (never reuse production keys; *.pem is git-ignored):
#   openssl genpkey -algorithm ed25519 -out jwt-local.pem
#   openssl pkey -in jwt-local.pem -pubout -out jwt-local.pub.pem
# Then paste each PEM on one line with literal \n between lines, e.g.:
#   awk 'NR>1{printf "\\n"}{printf "%s",$0}' jwt-local.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Token lifetimes (same values as wrangler.toml [env.*] vars).
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ---------------------------------------------------------------------------
# Optional integrations (leave empty; feature disabled)
# ---------------------------------------------------------------------------
# Social sign-in providers. Leave a pair empty to leave that provider off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Transactional email via mails.elixpo. When unset, emails are skipped and a
# warning is logged (OTP codes etc. are not delivered).
MAILS_SHARED_SECRET=
MAILS_HOOK_USER_VERIFY_OTP=
MAILS_HOOK_PASSWORD_RESET=
MAILS_HOOK_LOGIN_OTP=
MAILS_HOOK_MFA_EMAIL=
MAILS_HOOK_OAUTH_APP_REGISTER=
MAILS_HOOK_OAUTH_APP_DELETE=
MAILS_HOOK_ACCOUNT_SUSPENDED=
MAILS_HOOK_SIGN_IN_DEVICE=
MAILS_HOOK_WEBHOOK_FAIL=
MAILS_HOOK_BILLING_SUBSCRIPTION_ACTIVATED=
MAILS_HOOK_BILLING_PAYMENT_FAILED=
MAILS_HOOK_BILLING_SUBSCRIPTION_CANCELLED=

# Tunables with code defaults.
EMAIL_VERIFICATION_OTP_EXPIRY_MINUTES=10
AUTHORIZATION_TIMEOUT_SECONDS=600

# Billing / plan tiers via payouts.elixpo.
PAYOUTS_API_BASE=
ELIXPO_ACCOUNTS_PAYOUT_CLIENT_SECRET=
PAYOUTS_WEBHOOK_SECRET=

# Token-revocation webhook to LixBlogs.
BLOGS_CLIENT_ID=
BLOGS_REVOKE_WEBHOOK_URL=
BLOGS_REVOKE_WEBHOOK_SECRET=

# Use the remote D1 database over the Cloudflare REST API instead of the
# local binding. Leave empty to use the local D1 emulation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DATABASE_ID=

# Helper scripts only (scripts/test-email.js, scripts/mock-lixblogs-cli.mjs).
TEST_EMAIL=
SMTP_FROM_EMAIL=
ACCOUNTS_BASE_URL=http://localhost:3000
CLIENT_ID=lixblogs-cli-dev

# ---------------------------------------------------------------------------
# Deploy-only (maintainers)
# ---------------------------------------------------------------------------
# Bearer secrets that protect the scheduled cron endpoints in production.
REFRESH_TOKEN_CLEANUP_CRON_SECRET=
DEVICE_CLEANUP_CRON_SECRET=
